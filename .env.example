# Copy this file to .env.local and fill in real values.
# NEVER commit .env files: this repository is public.

# Runtime environment: development | test | production
NODE_ENV=development

# PostgreSQL connection (Neon in production; a local Postgres for development).
# On Vercel these are set automatically by the Neon integration.
DATABASE_URL=
# Direct (non-pooled) connection used only by migrations. Optional locally.
DATABASE_URL_UNPOOLED=

# Secret used to sign admin session cookies (at least 32 characters).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Only needed when running `next start` locally; Vercel sets it automatically.
# AUTH_TRUST_HOST=true

# Code needed at /admin/crear-cuenta to create the panel account (at least 16
# characters). Only used while no account exists; afterwards the page is closed.
# Generate one with: openssl rand -base64 24
ADMIN_SETUP_CODE=

# Vercel Blob for gift photos. Set automatically on Vercel when the Blob store is
# connected: newer stores set BLOB_STORE_ID (authenticated with Vercel OIDC),
# older ones BLOB_READ_WRITE_TOKEN. Leave both empty locally to store photos in
# .dev-uploads/.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Disposable database for integration tests (NEVER the production database).
TEST_DATABASE_URL=
