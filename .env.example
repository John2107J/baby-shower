# Copy this file to .env.local and fill in real values.
# NEVER commit .env files: this repository is public.

# Runtime environment: development | test | production
NODE_ENV=development

# PostgreSQL connection (Neon in production; a local Postgres for development).
# On Vercel these are set automatically by the Neon integration.
DATABASE_URL=
# Direct (non-pooled) connection used only by migrations. Optional locally.
DATABASE_URL_UNPOOLED=

# Secret used to sign admin session cookies (at least 32 characters).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Only needed when running `next start` locally; Vercel sets it automatically.
# AUTH_TRUST_HOST=true

# Disposable database for integration tests (NEVER the production database).
TEST_DATABASE_URL=
